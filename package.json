{
  "name": "expense-budget-tracker-vanilla-js-jest",
  "version": "1.0.0",
  "description": "Expense/Budget Tracker in Vanilla JavaScript with Jest and Stryker mutation testing.",
  "main": "src/budget.js",
  "scripts": {
    "start": "http-server . -p 3000 -c-1",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "mutation": "stryker run",
    "format": "prettier --write ."
  },
  "keywords": [
    "vanilla-js",
    "jest",
    "stryker",
    "testing",
    "coverage"
  ],
  "devDependencies": {
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/jest-runner": "^8.7.1",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "prettier": "^3.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/budget.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "html",
      "lcov"
    ]
  }
}
